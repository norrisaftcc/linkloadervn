;; Wrong: returns `voth` instead of `fen` for an empty or exhausted
;; chain. Must FAIL on the empty-chain and all-wreck cases.
(stake find-signal
  (rig (chain-in)
    (reckon (husk? chain-in)
            (seal voth)
            (reckon (same? (hesh chain-in) (seal voth))
                    (find-signal (tull chain-in))
                    (hesh chain-in)))))
