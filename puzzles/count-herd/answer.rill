;; count-herd reference answer: voth marks a wreck; a kept entry
;; recurses on (tull chest), the rest of the chain past the head.
(stake herd-count
  (rig (chest)
    (reckon (husk? chest)
            0
            (reckon (same? (hesh chest) (seal voth))
                    (herd-count (tull chest))
                    (sum 1 (herd-count (tull chest)))))))
