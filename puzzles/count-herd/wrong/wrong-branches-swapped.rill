;; Wrong: the inner reckon's two branches are swapped, so this counts
;; the wrecks instead of the kin. Must FAIL: on (haan voth haan) it
;; gives 1, not 2.
(stake herd-count
  (rig (chest)
    (reckon (husk? chest)
            0
            (reckon (same? (hesh chest) (seal voth))
                    (sum 1 (herd-count (tull chest)))
                    (herd-count (tull chest))))))
